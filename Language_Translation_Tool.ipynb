import tkinter as tk
from tkinter import ttk, messagebox
import requests
import html


LANGUAGES = {
    "English": "en",
    "Hindi": "hi",
    "Marathi": "mr",
    "Telugu": "te",
    "Tamil": "ta",
    "Gujarati": "gu",
    "Bengali": "bn",
    "Kannada": "kn",
    "Malayalam": "ml",
    "Punjabi": "pa",
    "French": "fr",
    "German": "de",
    "Spanish": "es",
    "Italian": "it",
    "Portuguese": "pt",
    "Japanese": "ja",
    "Korean": "ko",
    "Chinese": "zh-CN",
    "Arabic": "ar",
    "Russian": "ru"
}


BG_COLOR = "#F4F7FB"
CARD_COLOR = "#FFFFFF"
PRIMARY_COLOR = "#2563EB"
PRIMARY_HOVER = "#1D4ED8"
TEXT_COLOR = "#1E293B"
SECONDARY_TEXT = "#64748B"
BORDER_COLOR = "#D9E1EC"
SUCCESS_COLOR = "#15803D"


def translate_text():
    text = input_text.get("1.0", tk.END).strip()

    source = source_language.get()
    target = target_language.get()

    if not text:
        messagebox.showwarning(
            "Input Required",
            "Please enter some text to translate."
        )
        return

    if source == target:
        output_text.config(state="normal")
        output_text.delete("1.0", tk.END)
        output_text.insert(tk.END, text)
        output_text.config(state="disabled")
        return

    url = "https://api.mymemory.translated.net/get"

    params = {
        "q": text,
        "langpair": f"{LANGUAGES[source]}|{LANGUAGES[target]}"
    }

    translate_button.config(
        text="Translating...",
        state="disabled"
    )

    root.update_idletasks()

    try:
        response = requests.get(
            url,
            params=params,
            timeout=15
        )

        response.raise_for_status()

        data = response.json()

        if data.get("responseStatus") != 200:
            raise ValueError("Translation service returned an error.")

        translated_text = data.get(
            "responseData",
            {}
        ).get(
            "translatedText"
        )

        if not translated_text:
            raise ValueError("No translation was returned.")

        translated_text = html.unescape(translated_text)

        output_text.config(state="normal")
        output_text.delete("1.0", tk.END)
        output_text.insert(tk.END, translated_text)
        output_text.config(state="disabled")

        status_label.config(
            text="✓ Translation completed successfully",
            fg=SUCCESS_COLOR
        )

    except requests.exceptions.Timeout:
        messagebox.showerror(
            "Connection Error",
            "The translation service timed out.\nPlease try again."
        )

    except requests.exceptions.RequestException:
        messagebox.showerror(
            "Connection Error",
            "Unable to connect to the translation service.\n"
            "Please check your internet connection."
        )

    except ValueError as error:
        messagebox.showerror(
            "Translation Error",
            str(error)
        )

    finally:
        translate_button.config(
            text="Translate",
            state="normal"
        )


def clear_text():
    input_text.delete("1.0", tk.END)

    output_text.config(state="normal")
    output_text.delete("1.0", tk.END)
    output_text.config(state="disabled")

    status_label.config(
        text="Ready to translate",
        fg=SECONDARY_TEXT
    )


def swap_languages():
    source = source_language.get()
    target = target_language.get()

    source_language.set(target)
    target_language.set(source)

    input_value = input_text.get("1.0", tk.END).strip()
    output_value = output_text.get("1.0", tk.END).strip()

    input_text.delete("1.0", tk.END)
    input_text.insert(tk.END, output_value)

    output_text.config(state="normal")
    output_text.delete("1.0", tk.END)
    output_text.insert(tk.END, input_value)
    output_text.config(state="disabled")


def copy_translation():
    translation = output_text.get("1.0", tk.END).strip()

    if not translation:
        messagebox.showwarning(
            "No Translation",
            "There is no translated text to copy."
        )
        return

    root.clipboard_clear()
    root.clipboard_append(translation)

    status_label.config(
        text="✓ Translation copied to clipboard",
        fg=SUCCESS_COLOR
    )


